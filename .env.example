# Copy to .env and fill in. The image server is private (course data), so these
# values are only useful if you have access to it.
HERBARIUM_API_URL=https://example.org
HERBARIUM_CLIENT_CERT=certs/client.crt
HERBARIUM_CLIENT_KEY=certs/client.key
HERBARIUM_CA_CERT=certs/ca.crt
HERBARIUM_API_USER=user
HERBARIUM_API_PASSWORD=
